# Copy to deploy/compose/.env before `make up`. Local-only values — never a
# real credential; the repo holds no checked-in config (12-factor).

# --- postgres container ---
POSTGRES_USER=porygon
POSTGRES_PASSWORD=porygon
POSTGRES_DB=porygon
# Host-side port, published on loopback only. Container-internal port is 5432.
POSTGRES_PORT=5432

# --- AD-6 roles ---
# Created on first boot only; changing one of these needs `make clean` to take.
PORYGON_ETL_PASSWORD=porygon_etl
PORYGON_APP_PASSWORD=porygon_app
PORYGON_BATCH_PASSWORD=porygon_batch
PORYGON_ANALYTICS_PASSWORD=porygon_analytics

# --- migrate container ---
MIGRATE_DATABASE_URL=postgres://porygon_etl:${PORYGON_ETL_PASSWORD}@postgres:5432/${POSTGRES_DB}?sslmode=disable

# --- api container ---
DATABASE_URL=postgres://porygon_app:${PORYGON_APP_PASSWORD}@postgres:5432/${POSTGRES_DB}?sslmode=disable
# Host-side port, published on loopback only. Container-internal bind is fixed
# at :8080 by the compose file.
API_PORT=8080
# debug | info | warn | error
LOG_LEVEL=info

# --- read only when running the binary outside compose ---
# HTTP_ADDR=:8080
